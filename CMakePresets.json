{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "x86-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/${presetName}",
      "installDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "x86-debug",
      "inherits": "x86-base",
      "displayName": "x86 Debug (run from an x86 Native Tools prompt)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "x86-release",
      "inherits": "x86-base",
      "displayName": "x86 Release (run from an x86 Native Tools prompt)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    }
  ],
  "buildPresets": [
    { "name": "x86-debug", "configurePreset": "x86-debug", "targets": ["install"] },
    { "name": "x86-release", "configurePreset": "x86-release", "targets": ["install"] }
  ],
  "packagePresets": [
    { "name": "x86-release", "configurePreset": "x86-release", "generators": ["ZIP"] }
  ]
}
